# Copy to .env (repo root for docker-compose, or backend/.env when running locally)
# NEVER commit the real .env.

# ── Blockradar API ──
# In DATA_MODE=real every workspace connects ITS OWN wallet in Settings (key stored encrypted).
# These two are only used to auto-connect the BOOTSTRAP_ADMIN_EMAIL account (self-hosting convenience).
BLOCKRADAR_API_KEY=
BLOCKRADAR_BASE_URL=https://api.blockradar.co/v1
BLOCKRADAR_WALLET_ID=
BOOTSTRAP_ADMIN_EMAIL=

# ── Database ──
# Leave unset for local SQLite. Use Postgres in production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_PASSWORD=change-me   # only used by docker-compose

# ── Backend ──
DEBUG=false
# Encrypts stored Blockradar keys. Any random string; set once and never change it.
ENCRYPTION_KEY=
# Optional: enables the Ask ERNIE assistant. Workspaces must also opt in. Other knobs: ASSISTANT_MODEL, ASSISTANT_FALLBACKS, AI_MONTHLY_LIMIT
ANTHROPIC_API_KEY=
# Optional: comma-separated emails allowed into the platform admin console (the account must be verified)
PLATFORM_ADMIN_EMAILS=
# Optional: paid plans. Create two recurring monthly Prices in Stripe (Pro, Business), then add a webhook endpoint
# <API URL>/billing/webhook for: checkout.session.completed and customer.subscription.created/updated/deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# REQUIRED, 32+ chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=

# ── Email (password reset, email confirmation, emailed invites) ──
# "console" = don't send (safe default; with DEBUG=true messages print to the log). "smtp" = send for real.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls   # starttls | ssl | none
EMAIL_FROM=ERNIE <no-reply@yourdomain.com>
# Public URL of the web app (used for links inside emails)
PUBLIC_APP_URL=http://localhost:5173

# ── Pipeline ──
DATA_MODE=simulated   # "simulated": everyone sees demo data (local dev) | "real": per-workspace Blockradar connections
PIPELINE_SCHEDULE_HOURS=6
