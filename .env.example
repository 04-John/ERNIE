# Copy to .env (repo root for docker-compose, or backend/.env when running locally)
# NEVER commit the real .env.

# ── Blockradar API ──
BLOCKRADAR_API_KEY=
BLOCKRADAR_BASE_URL=https://api.blockradar.co/v1
BLOCKRADAR_WALLET_ID=

# ── Database ──
# Leave unset for local SQLite. Use Postgres in production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_PASSWORD=change-me   # only used by docker-compose

# ── Backend ──
DEBUG=false
# REQUIRED, 32+ chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=

# ── Pipeline ──
DATA_MODE=simulated   # "real" or "simulated"
PIPELINE_SCHEDULE_HOURS=6
